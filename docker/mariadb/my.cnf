[mysqld]
# =============================================================================
# MariaDB 10.11 Low-Memory Tuning for 1GB RAM Instance (t2.micro)
# =============================================================================
# Disable performance_schema to save ~100 MiB RAM on constrained instances
performance_schema = OFF

# InnoDB Buffer Pool sized appropriately for 1GB RAM alongside LGTM stack
innodb_buffer_pool_size = 128M
innodb_log_file_size = 32M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# Connection & Buffer limits
max_connections = 40
thread_cache_size = 8
table_open_cache = 400
table_definition_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
join_buffer_size = 256K
sort_buffer_size = 512K
read_buffer_size = 256K
read_rnd_buffer_size = 256K

# Security & Networking
skip_name_resolve = ON
local_infile = 0

# Slow Query Logging for Production Diagnostics
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1.0
